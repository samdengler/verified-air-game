/-- [review_game::title]:
    Source: 'src/lib.rs', lines 113:0-121:1
    Visibility: public -/
def title (upheld : Std.U32) (checks : Std.U32) : Result Title := do
  if 6#u32 <= upheld
  then
    if 6#u32 <= checks
    then ok Title.StationManager
    else
      if 3#u32 <= upheld
      then if 3#u32 <= checks
           then ok Title.DutyManager
           else ok Title.ShiftLead
      else ok Title.ShiftLead
  else
    if 3#u32 <= upheld
    then if 3#u32 <= checks
         then ok Title.DutyManager
         else ok Title.ShiftLead
    else ok Title.ShiftLead

