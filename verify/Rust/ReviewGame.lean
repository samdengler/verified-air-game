/-- [review_game::close_week]:
    Source: 'src/lib.rs', lines 144:0-152:1
    Visibility: public -/
def close_week (s : Streak) (answered : Bool) : Result Streak := do
  if answered
  then let i ← s.weeks + 1#u32
       ok { s with weeks := i }
  else
    if 0#u32 < s.passes
    then let i ← s.passes - 1#u32
         ok { s with passes := i }
    else ok { s with weeks := 0#u32 }

