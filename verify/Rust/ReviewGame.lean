def yes_stays_right (k : CardKind) : Result Bool := do
  match k with
  | CardKind.Predict => ok false
  | CardKind.Confirm => ok true
  | CardKind.Decide => ok false
  | CardKind.Check => ok true
  | CardKind.FollowUp => ok true
  | CardKind.Reconcile => ok false

/-- [review_game::sides_swapped]:
    Source: 'src/lib.rs', lines 177:0-183:1
    Visibility: public -/
def sides_swapped
  (k : CardKind) (seed : Std.U32) (index : Std.U32) : Result Bool := do
  let b ← yes_stays_right k
  if b
  then ok false
  else
    let i ← seed % 2#u32
    let i1 ← index % 2#u32
    let i2 ← i + i1
    let i3 ← i2 % 2#u32
    ok (i3 = 1#u32)

