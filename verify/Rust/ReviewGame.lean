def judge (k : CardKind) (r : Response) : Result Outcome := do
  match r with
  | Response.Agrees =>
    match k with
    | CardKind.Predict => ok Outcome.SameCall
    | CardKind.Confirm => ok Outcome.SameCall
    | CardKind.Decide => ok Outcome.DecisionSent
    | CardKind.Check => ok Outcome.CheckMissed
    | CardKind.FollowUp => ok Outcome.SameCall
    | CardKind.Reconcile => ok Outcome.DecisionSent
  | Response.Differs =>
    match k with
    | CardKind.Predict => ok Outcome.PossibleCatch
    | CardKind.Confirm => ok Outcome.PossibleCatch
    | CardKind.Decide => ok Outcome.DecisionSent
    | CardKind.Check => ok Outcome.CheckPassed
    | CardKind.FollowUp => ok Outcome.PossibleCatch
    | CardKind.Reconcile => ok Outcome.DecisionSent
  | Response.Depends => ok Outcome.Exception
  | Response.NotMine => ok Outcome.Routed

/-- [review_game::loudness]:
    Source: 'src/lib.rs', lines 97:0-104:1
    Visibility: public -/
def loudness (o : Outcome) : Result Std.U32 := do
  match o with
  | Outcome.SameCall => ok 1#u32
  | Outcome.PossibleCatch => ok 3#u32
  | Outcome.Exception => ok 1#u32
  | Outcome.DecisionSent => ok 2#u32
  | Outcome.CheckPassed => ok 3#u32
  | Outcome.CheckMissed => ok 0#u32
  | Outcome.Routed => ok 0#u32

