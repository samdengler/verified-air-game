/-- [review_game::advance]:
    Source: 'src/lib.rs', lines 30:0-36:1
    Visibility: public -/
def advance (s : Session) : Result Session := do
  if s.index < s.length
  then
    let i ← s.length - s.index
    if i > 1#u32
    then
      let i1 ← s.index + 1#u32
      ok { s with phase := Phase.Asking, index := i1 }
    else ok { s with phase := Phase.Done }
  else ok { s with phase := Phase.Done }

/-- [review_game::step]:
    Source: 'src/lib.rs', lines 38:0-53:1
    Visibility: public -/
def step (s : Session) (e : Event) : Result (Option Session) := do
  match s.phase with
  | Phase.Intro =>
    match e with
    | Event.Start =>
      if s.length = 0#u32
      then ok (some { s with phase := Phase.Done })
      else ok (some { s with phase := Phase.Asking })
    | Event.Call => ok none
    | Event.Depends => ok none
    | Event.NotMine => ok none
    | Event.Next => ok none
  | Phase.Asking =>
    match e with
    | Event.Start => ok none
    | Event.Call => ok (some { s with phase := Phase.Revealed })
    | Event.Depends => ok (some { s with phase := Phase.Revealed })
    | Event.NotMine => let s1 ← advance s
                       ok (some s1)
    | Event.Next => ok none
  | Phase.Revealed =>
    match e with
    | Event.Start => ok none
    | Event.Call => ok none
    | Event.Depends => ok none
    | Event.NotMine => ok none
    | Event.Next => let s1 ← advance s
                    ok (some s1)
  | Phase.Done => ok none

