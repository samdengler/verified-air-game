    Visibility: public -/
def revealed
  (rule : RevealRule) (answered : Std.U32) (not_mine : Std.U32)
  (on_leave : Std.U32) (waiting : Std.U32) :
  Result Bool
  := do
  match rule with
  | RevealRule.EverySeat =>
    if waiting = 0#u32
    then
      if not_mine = 0#u32
      then if on_leave = 0#u32
           then ok (0#u32 < answered)
           else ok false
      else ok false
    else ok false
  | RevealRule.EveryoneAvailable =>
    if waiting = 0#u32
    then ok (0#u32 < answered)
    else ok false

