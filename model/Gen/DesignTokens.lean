import Design.Rules
import Game.Streak
import Game.Session

/-! `lake exe design-tokens [dir]` writes everything people and tools read about the design
system from the model: CSS, W3C design tokens, Swift, Kotlin, documentation, and the
expectations the UI checks run against. -/

open Design

def hex2 (n : Nat) : String :=
  let d := "0123456789ABCDEF".toList
  String.ofList [d.getD (n / 16) '0', d.getD (n % 16) '0']

def Design.Color.hex (c : Color) : String := s!"#{hex2 c.r}{hex2 c.g}{hex2 c.b}"

/-- `airline-blue` as `airlineBlue`. -/
def camel (s : String) : String :=
  match s.splitOn "-" with
  | [] => s
  | w :: rest => w ++ String.join (rest.map String.capitalize)

def header (c : String) : String := s!"{c} Generated by `lake exe design-tokens` from model/Design. Change the model, not this file.\n"

def css : String := Id.run do
  let mut out := "/* Generated by `lake exe design-tokens` from model/Design. Change the model, not this file. */\n"
  out := out ++ ":root {\n"
  for t in Token.all do out := out ++ s!"  --color-{t.name}: {t.color.hex};\n"
  for s in Surface.all do
    out := out ++ s!"  --surface-{s.name}: var(--color-{s.ground.name});\n"
    out := out ++ s!"  --ink-{s.name}: var(--color-{s.ink.name});\n"
    out := out ++ s!"  --focus-{s.name}: var(--color-{s.focusRing.name});\n"
  for r in TypeRole.all do out := out ++ s!"  --type-{r.name}: {r.px}px;\n"
  out := out ++ s!"  --touch-target: {minTouchTarget}px;\n"
  for m in motions do out := out ++ s!"  --motion-{m.name}: {m.ms}ms;\n"
  out := out ++ "}\n\n@media (prefers-reduced-motion: reduce) {\n  :root {\n"
  for m in motions do out := out ++ s!"    --motion-{m.name}: {m.reducedMs}ms;\n"
  return out ++ "  }\n}\n"

def channel (n : Nat) : String :=
  let thousandths := n * 1000 / 255
  let frac := thousandths % 1000
  let pad := if frac < 10 then "00" else if frac < 100 then "0" else ""
  s!"{thousandths / 1000}.{pad}{frac}"

def dtcg : String := Id.run do
  let colors := Token.all.map fun t =>
    let c := t.color
    s!"    \"{t.name}\": \{ \"$type\": \"color\", \"$description\": \"{t.purpose}\", \"$value\": \{ \"colorSpace\": \"srgb\", \"components\": [{channel c.r}, {channel c.g}, {channel c.b}], \"hex\": \"{c.hex}\" } }"
  let types := TypeRole.all.map fun r =>
    s!"    \"{r.name}\": \{ \"$type\": \"dimension\", \"$value\": \{ \"value\": {r.px}, \"unit\": \"px\" } }"
  let motion := motions.map fun m =>
    s!"    \"{m.name}\": \{ \"$type\": \"duration\", \"$value\": \{ \"value\": {m.ms}, \"unit\": \"ms\" } }"
  return "{\n  \"color\": {\n" ++ ",\n".intercalate colors ++ "\n  },\n  \"type\": {\n" ++ ",\n".intercalate types ++
    s!"\n  },\n  \"touch-target\": \{ \"$type\": \"dimension\", \"$value\": \{ \"value\": {minTouchTarget}, \"unit\": \"px\" } },\n  \"motion\": \{\n" ++
    ",\n".intercalate motion ++ "\n  }\n}\n"

def swift : String := Id.run do
  let mut out := header "//" ++ "import SwiftUI\n\nenum Tokens {\n"
  for t in Token.all do
    let c := t.color
    out := out ++ s!"    static let {camel t.name} = Color(red: {c.r} / 255, green: {c.g} / 255, blue: {c.b} / 255)\n"
  out := out ++ s!"    static let touchTarget: CGFloat = {minTouchTarget}\n"
  for r in TypeRole.all do out := out ++ s!"    static let type{r.name.capitalize}: CGFloat = {r.px}\n"
  return out ++ "}\n"

def kotlin : String := Id.run do
  let mut out := header "//" ++ "import androidx.compose.ui.graphics.Color\nimport androidx.compose.ui.unit.dp\nimport androidx.compose.ui.unit.sp\n\nobject Tokens {\n"
  for t in Token.all do
    out := out ++ s!"    val {camel t.name} = Color(0xFF{t.color.hex.drop 1})\n"
  out := out ++ s!"    val touchTarget = {minTouchTarget}.dp\n"
  for r in TypeRole.all do out := out ++ s!"    val type{r.name.capitalize} = {r.px}.sp\n"
  return out ++ "}\n"

def ratio (n : Nat) : String :=
  let f := n % 100
  s!"{n / 100}.{if f < 10 then "0" else ""}{f}"

def docs : String := Id.run do
  let mut out := "<!-- Generated by `lake exe design-tokens` from model/Design. Change the model, not this file. -->\n"
  out := out ++ "\n# The Gate Check design system\n\nEvery value below is read from the Lean model, and every rule is a theorem Lean checks on each build.\n\n## Colours\n\n| Token | Value | Purpose |\n| --- | --- | --- |\n"
  for t in Token.all do out := out ++ s!"| `{t.name}` | `{t.color.hex}` | {t.purpose} |\n"
  out := out ++ "\n## Surfaces\n\n| Surface | Ground | Ink | Focus ring |\n| --- | --- | --- | --- |\n"
  for s in Surface.all do out := out ++ s!"| {s.name} | `{s.ground.name}` | `{s.ink.name}` | `{s.focusRing.name}` |\n"
  out := out ++ "\n## Allowed colour pairs\n\nThe contrast shown is a lower bound from exact arithmetic.\n\n| Colour | On | For | Needs | Measures at least |\n| --- | --- | --- | --- | --- |\n"
  for p in allowedPairs do
    out := out ++ s!"| `{p.fg.name}` | `{p.bg.name}` | {p.use.name} | {ratio p.use.required} | {ratio p.low} |\n"
  out := out ++ "\n## Forbidden colour pairs\n\nThe contrast shown is an upper bound, so these fail on any rounding.\n\n| Colour | On | For | Needs | Measures at most |\n| --- | --- | --- | --- | --- |\n"
  for p in forbiddenPairs do
    out := out ++ s!"| `{p.fg.name}` | `{p.bg.name}` | {p.use.name} | {ratio p.use.required} | {ratio (contrastHigh p.fg.color p.bg.color)} |\n"
  out := out ++ "\n## Type\n\n| Role | Size |\n| --- | --- |\n"
  for r in TypeRole.all do out := out ++ s!"| {r.name} | {r.px} px |\n"
  out := out ++ s!"\nNo text is smaller than {minTextPx} px. Text from {largeTextPx} px counts as large for contrast.\n\n## Touch targets\n\nEvery control is at least {minTouchTarget} px tall.\n\n| Control | Height |\n| --- | --- |\n"
  for c in controls do out := out ++ s!"| {c.name} | {c.height} px |\n"
  out := out ++ s!"\n## Motion\n\nNo animation runs longer than {maxMotionMs} ms, and reduced motion removes them all.\n\n| Motion | Duration | With reduced motion |\n| --- | --- | --- |\n"
  for m in motions do out := out ++ s!"| {m.name} | {m.ms} ms | {m.reducedMs} ms |\n"
  return out

/-- What the UI checks compare a rendered page against. -/
def checks : String := Id.run do
  let toks := Token.all.map fun t => s!"\"{t.color.hex}\""
  let pairs := allowedPairs.map fun p =>
    s!"\{\"fg\":\"{p.fg.color.hex}\",\"bg\":\"{p.bg.color.hex}\",\"use\":\"{p.use.name}\"}"
  let forbidden := forbiddenPairs.map fun p =>
    s!"\{\"fg\":\"{p.fg.color.hex}\",\"bg\":\"{p.bg.color.hex}\",\"use\":\"{p.use.name}\"}"
  return s!"\{\n  \"tokens\": [{", ".intercalate toks}],\n  \"minTouchTarget\": {minTouchTarget},\n  \"minTextPx\": {minTextPx},\n  \"largeTextPx\": {largeTextPx},\n  \"required\": \{\"text\": 4.5, \"large text\": 3, \"graphics\": 3},\n  \"allowed\": [{",".intercalate pairs}],\n  \"forbidden\": [{",".intercalate forbidden}]\n}\n"

/-- What the page needs from the model that is data and not a rule to run: which surface goes with what, and the
model's limits. The page reads these values and keeps no copy of them. -/
def modelJs : String := Id.run do
  let quoted (xs : List String) := ", ".intercalate (xs.map fun x => s!"\"{x}\"")
  let outcomes := quoted (Game.Outcome.all.map fun o => (surfaceOf o).name)
  let kinds := quoted (Game.CardKind.all.map fun k => (askingSurface k).name)
  return s!"// Generated by `lake exe design-tokens` from the model. Change the model, not this file.\nwindow.MODEL = \{\n  surfaceOfOutcome: [{outcomes}],\n  askingSurface: [{kinds}],\n  passLimit: {Game.passLimit},\n  shiftLimit: {Game.shiftLimit},\n};\n"

def main (args : List String) : IO Unit := do
  let dir : System.FilePath := args.headD "../design"
  IO.FS.createDirAll dir
  IO.FS.writeFile (dir / "tokens.css") css
  IO.FS.writeFile (dir / "tokens.json") dtcg
  IO.FS.writeFile (dir / "Tokens.swift") swift
  IO.FS.writeFile (dir / "Tokens.kt") kotlin
  IO.FS.writeFile (dir / "DESIGN.md") docs
  IO.FS.writeFile (dir / "checks.json") checks
  IO.FS.writeFile (dir / "model.js") modelJs
  IO.println s!"wrote the design system to {dir}"
