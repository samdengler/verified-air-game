import Lean
import Game.Spec
import Design.Spec

/-! `lake exe specs [dir]` writes `.kiro/specs` from the model: the values in
`Game.Spec`, and each theorem's statement and axioms read from the compiled
environment. It parses no docstring, and it stops if a named theorem is missing or
rests on `sorry` or any axiom outside Lean's standard three. -/

open Lean Meta Game Game.Spec

def oneLine (s : String) : String :=
  " ".intercalate ((s.splitOn "\n").map (·.trimAscii.toString))

def allowedAxioms : List Name := [``propext, ``Classical.choice, ``Quot.sound]

def statement (n : Name) : MetaM String := do
  let some info := (← getEnv).find? n | throwError "{n} is not in the model"
  return oneLine (toString (← PrettyPrinter.ppExpr info.type))

/-- Fails if the theorem rests on anything but Lean's standard axioms. -/
def checkAxioms (n : Name) : MetaM Unit := do
  let axioms ← collectAxioms n
  for a in axioms do
    unless allowedAxioms.contains a do
      throwError "{n} depends on {a}"

def where_ (n : Name) : MetaM String := do
  let env ← getEnv
  let some idx := env.getModuleIdxFor? n | return "model"
  let some mod := env.header.moduleNames[idx.toNat]? | return "model"
  let file := "/".intercalate (mod.components.map toString)
  match ← findDeclarationRanges? n with
  | some r => return s!"model/{file}.lean:{r.range.pos.line}"
  | none => return s!"model/{file}.lean"

def shortName (n : Name) : String :=
  ((n.toString.replace "Game." "").replace "Design." "")

structure Rendered where
  status : String
  lines : List String

def renderBasis : Basis → MetaM Rendered
  | .modelled src => do
    return { status := "modelled"
             lines := [s!"Read by running `{shortName src}` ({← where_ src}), and checked in every engine by the vectors"] }
  | .proven thm => do
    checkAxioms thm
    return { status := "proven"
             lines := [s!"Theorem `{shortName thm}` ({← where_ thm})",
                       s!"Lean: `{← statement thm}`"] }
  | .openQuestion problem proposal => do
    checkAxioms problem
    checkAxioms proposal
    return { status := "open question"
             lines := [s!"The rule as mocked up can fail: `{shortName problem}` ({← where_ problem})",
                       s!"This wording is the proposed fix, not yet decided: `{shortName proposal}` ({← where_ proposal})",
                       s!"Problem in Lean: `{← statement problem}`",
                       s!"Fix in Lean: `{← statement proposal}`"] }

structure Tallied where
  text : String
  counts : List (String × Nat)

def header (what : String) : String :=
  s!"<!-- Generated by `lake exe specs` from {what}. Change the model, not this file. -->\n"

def renderRequirement (r : Requirement) : MetaM Tallied := do
  let mut out := s!"### Requirement {r.id}\n\n**Title:** {r.title}\n\n**User Story:** {r.story}\n\n#### Acceptance Criteria\n\n"
  let mut counts : List (String × Nat) := []
  let mut i := 1
  for c in r.criteria do
    let rendered ← renderBasis c.basis
    out := out ++ s!"{i}. {c.ears.render}\n   - {r.id}.{i}, {rendered.status}\n"
    for l in rendered.lines do
      out := out ++ s!"   - {l}\n"
    counts := (rendered.status, 1) :: counts
    i := i + 1
  return { text := out ++ "\n", counts }

def requirementsFile (f : SpecFile) : MetaM (String × List (String × Nat)) := do
  let mut out := header "the Lean values in `model/Game/Spec.lean`" ++
    s!"\n# Requirements Document: {f.title}\n\n## Introduction\n\n{f.intro}\n\n" ++
    "Each criterion carries where it comes from. *modelled* means the sentence was computed by running the model. *proven* means Lean checked a theorem for every input, shown with its statement. *open question* means the model shows a problem and someone has to decide.\n\n## Requirements\n\n"
  let mut counts := []
  for r in f.requirements do
    let t ← renderRequirement r
    out := out ++ t.text
    counts := counts ++ t.counts
  return (out, counts)

/-- A type's shape, read from the compiled model. -/
def describeType (n : Name) : MetaM String := do
  let env ← getEnv
  if isStructure env n then
    let fields := getStructureFields env n
    let mut rows : List String := []
    for field in fields do
      let some proj := getProjFnForField? env n field | continue
      let some info := env.find? proj | continue
      let ty ← forallTelescope info.type fun _ b => do
        return oneLine (toString (← PrettyPrinter.ppExpr b))
      rows := rows ++ [s!"`{field}: {ty}`"]
    return s!"- `{shortName n}`, a structure: {", ".intercalate rows}"
  else
    let some (.inductInfo i) := env.find? n | return s!"- `{shortName n}`"
    let ctors := i.ctors.map fun c => s!"`{c.getString!}`"
    return s!"- `{shortName n}`, one of: {", ".intercalate ctors}"

def stateTable : String := Id.run do
  let mut out := "## State table\n\nComputed by running `Session.step`.\n\n| Screen | Action | Result |\n| --- | --- | --- |\n"
  for p in Phase.all do
    for e in Event.all do
      match effects p e with
      | [] => pure ()
      | rows =>
        for (why, effect) in rows do
          out := out ++ s!"| {phaseName p} ({why}) | {eventName e} | {effect} |\n"
  out := out ++ "\n```mermaid\nstateDiagram-v2\n  [*] --> Intro\n"
  for p in Phase.all do
    for e in Event.all do
      for (s, _) in samples p do
        if let some t := s.step e then
          out := out ++ s!"  {phaseName p} --> {phaseName t.phase}: {eventName e}\n"
  out := out ++ "  Report --> [*]\n```\n\n"
  -- A transition sampled twice to the same screen is drawn once.
  let lines := (out.splitOn "\n").eraseDups
  return "\n".intercalate lines

def designFile (f : SpecFile) : MetaM String := do
  let mut out := header "the compiled model" ++ s!"\n# Design Document: {f.title}\n\n## Overview\n\n{f.intro}\n\n## Data models\n\nRead from the compiled Lean types.\n\n"
  for t in f.types do
    out := out ++ (← describeType t) ++ "\n"
  out := out ++ "\n"
  if f.stateTable then out := out ++ stateTable ++ "\n"
  unless f.engine.isEmpty do
    out := out ++ "## Engine interface\n\nEvery engine exposes these over whole numbers. The same vectors in `vectors/engine.jsonl` check all of them.\n\n"
    for e in f.engine do
      out := out ++ s!"- `{e.wire}`, from `{shortName e.source}` ({← where_ e.source}): `{← statement e.source}`\n"
    out := out ++ "\n"
  out := out ++ "## Correctness properties\n\nEach is a theorem Lean checked for every input. The implementation inherits them only as far as its target allows: see the implementation plan.\n\n"
  for r in f.requirements do
    for c in r.criteria do
      match c.basis with
      | .proven thm => out := out ++ s!"- **{shortName thm}** ({r.id}): `{← statement thm}`\n"
      | _ => pure ()
  return out

def tasksFile (f : SpecFile) : String := Id.run do
  let mut out := header "the model's spec values" ++ s!"\n# Implementation Plan: {f.title}\n\n"
  let mut n := 1
  let ids := fun (r : Requirement) => (List.range r.criteria.length).map fun i => s!"{r.id}.{i + 1}"
  let allIds := f.requirements.flatMap ids
  unless f.engine.isEmpty do
    for t in targets do
      let fns := ", ".intercalate (f.engine.map (s!"`{·.wire}`"))
      out := out ++ s!"- [ ] {n}. Implement {fns} in {t.name}\n  - Code lives in `{t.path}`\n  - Done when {t.check}\n  - _Requirements: {", ".intercalate allIds}_\n\n"
      n := n + 1
  for r in f.requirements do
    out := out ++ s!"- [ ] {n}. Build the screens and behaviour for {r.title}\n  - Draw what the engine returns, with no rule logic in the page\n  - Replay the vectors through the real page in headless Chrome\n  - _Requirements: {", ".intercalate (ids r)}_\n\n"
    n := n + 1
  return out

def countOf (status : String) (counts : List (String × Nat)) : Nat :=
  (counts.filter (·.1 == status)).length

def indexFile (rows : List (SpecFile × List (String × Nat))) : String := Id.run do
  let mut out := header "the model" ++ "\n# Gate Check specs\n\nThese Kiro specs are generated from the Lean model in `model/`. To change one, change the model and run `lake exe specs` there.\n\n| Spec | Requirements | Modelled | Proven | Open questions |\n| --- | --- | --- | --- | --- |\n"
  for (f, c) in rows do
    let reqs := " ".intercalate (f.requirements.map (·.id))
    out := out ++ s!"| [{f.title}]({f.folder}/requirements.md) | {reqs} | {countOf "modelled" c} | {countOf "proven" c} | {countOf "open question" c} |\n"
  return out

def run (dir : System.FilePath) : MetaM Unit := do
  let mut rows := []
  for f in Spec.all ++ Design.Spec.all do
    let folder := dir / f.folder
    IO.FS.createDirAll folder
    let (req, counts) ← requirementsFile f
    IO.FS.writeFile (folder / "requirements.md") req
    IO.FS.writeFile (folder / "design.md") (← designFile f)
    IO.FS.writeFile (folder / "tasks.md") (tasksFile f)
    rows := rows ++ [(f, counts)]
  IO.FS.writeFile (dir / "README.md") (indexFile rows)
  let total := rows.flatMap (·.2)
  IO.println s!"wrote {rows.length} specs: {countOf "modelled" total} modelled, {countOf "proven" total} proven, {countOf "open question" total} open"

def main (args : List String) : IO UInt32 := do
  let dir := args.headD "../.kiro/specs"
  initSearchPath (← findSysroot)
  unsafe enableInitializersExecution
  let env ← importModules #[{ module := `Game }, { module := `Design }] {} (loadExts := true)
  let ctx : Core.Context := { fileName := "<specs>", fileMap := default }
  try
    let _ ← ((run dir).run' {}).toIO ctx { env }
    return 0
  catch e =>
    IO.eprintln s!"specs: {e}"
    return 1
